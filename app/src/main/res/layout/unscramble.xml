<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.2"
        android:id="@+id/line1"
        />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_gravity="center"
        app:layout_constraintTop_toTopOf="@id/line1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/linear1">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unscramble"
            android:layout_gravity="center"
            android:textSize="20dp"
            android:layout_margin="10dp"

            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:background="@drawable/corner_boxstyle"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/corner_boxstyle"
                android:text="1/10"
                android:textColor="@color/white"
                android:backgroundTint="#0800FF"
                android:layout_gravity="right"
                android:textSize="20dp"
                android:id="@+id/tvLevel"
                android:padding="10dp"
                android:textStyle="bold"

                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amred"
                android:textSize="50dp"
                android:layout_gravity="center"
                android:textStyle="bold"
                android:id="@+id/tvWord"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unscramble the word to make a real word"
                android:layout_gravity="center"
                android:textSize="18dp"
                android:layout_margin="10dp"
                />
            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your word here"
                android:layout_gravity="center"
                android:textSize="20dp"
                android:background="@drawable/corner_edittext_style"
                android:padding="15dp"
                android:backgroundTint="@color/white"
                android:layout_margin="10dp"
                android:id="@+id/edText"
                />


        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:layout_gravity="center"
            android:textSize="20dp"
            android:backgroundTint="#2196F3"
            android:background="@drawable/corner_boxstyle"
            android:layout_margin="10dp"
            android:id="@+id/btnSubmit"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skip"
            android:layout_gravity="center"
            android:textSize="20dp"
            android:background="@drawable/buttonstyle1"
            android:backgroundTint="@null"
            android:textColor="@color/black"
            android:layout_margin="10dp"
            android:id="@+id/btnSkip"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/corner_boxstyle"
            android:text="Score: 0"
            android:textSize="27dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:padding="15dp"
            android:textStyle="bold"
            android:id="@+id/tvScore"
            />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>